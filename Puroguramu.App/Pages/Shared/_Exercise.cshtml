@model Puroguramu.Domains.Exercice.ExerciseDisplay

@{
    ViewData["difficulty"] = Model.Exercise.Difficulty == "Easy" ? "#38d161AA" : @Model.Exercise.Difficulty == "Medium" ? "#dba032AA" : "#a83232AA";
    ViewData["finish"] = !Model.IsFinish ? "#a5a8a885" : "#3eb84485";
}

<article class="flex max-w-xl flex-col items-start justify-between" style="margin: 1rem">
    <div class="group relative" style="background-color: @ViewData["finish"];border: black solid 2px;padding: 0.4rem;border-radius: 0.6rem">
        <h3 class="mt-3 text-lg font-semibold leading-6 text-gray-900 group-hover:text-gray-600">
            @Model.Exercise.Name
        </h3>
        <p style="margin: 0.2rem;
                  padding: 0.5rem;
                  border: solid 0.1rem #000000;
                  border-radius: 1rem;
                  color: #FFFFFF;
                  background-color: @ViewData["difficulty"];">@Model.Exercise.Difficulty</p>
        <div class="flex items-center gap-x-4 text-xs">
            <a class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100" asp-page="/ExerciseView" asp-route-idExercise="@Model.Exercise.IdExercise">Go</a>
        </div>
    </div>
</article>