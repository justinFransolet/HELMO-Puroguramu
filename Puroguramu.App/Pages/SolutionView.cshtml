@page "exercise/solution/{idExercise:guid}"
@model Puroguramu.App.Pages.SolutionView

<!DOCTYPE html>

<html lang="fr">
    <head>
        <title>@ViewData["title"]</title>
        <meta charset="UTF-8">
        <link href="css/stylesheet.css" rel="stylesheet">
    </head>
    <body class="container mx-auto mt-8">
        <article class="flex max-w-xl flex-col items-start justify-between" style="margin: 1rem">
            <div class="group relative">
                <h1 class="text-3xl font-semibold leading-7 text-gray-900">Solution de l'exercice : @Model.Name</h1>
                <textarea asp-for="Solution" cols="100" rows="20" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"></textarea>
                <div class="flex items-center gap-x-4 text-xs">
                    <a class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100" asp-page="/ExerciseView" asp-route-idExercise="@Model.IdExercise">Retour</a>
                </div>
            </div>
        </article>
    </body>
</html>