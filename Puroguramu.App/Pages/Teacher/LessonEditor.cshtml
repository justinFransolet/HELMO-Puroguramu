@page "/lesson/edit/{idLesson:guid}"
@model Puroguramu.App.Pages.Teacher.LessonEditor

<!DOCTYPE html>

<html lang="fr">
    <head>
        <title>@ViewData["Title"]</title>
        <meta charset="UTF-8">
        <link href="css/stylesheet.css" rel="stylesheet">
    </head>
    <body class="container mx-auto mt-8">
    <form method="post">
        <input type="hidden" asp-for="IdLesson"/>
        <div class="border-b border-gray-900/10 pb-12" style="margin:1.5rem">
            <h2 class="text-3xl font-semibold leading-7 text-gray-900">Leçon : @Model.RealData.Name</h2>
            <p class="mt-1 text-sm leading-6 text-gray-600">Vous pouvez modifier cette leçon pour vos étudiants.</p>
            <form method="post" class="mt-10 grid grid-cols-1 gap-y-8 sm:grid-cols-6 flex-col" style="margin-bottom: 1rem">
                <input type="hidden" asp-for="IdLesson"/>
                <div class="col-span-full">
                    <label asp-for="Input.Name" class="block text-sm font-medium leading-6 text-gray-900">
                        Nom :
                        <input type="text" asp-for="Input.Name" placeholder="@Model.RealData.Name" class="mt-2 rounded-md"/>
                    </label>
                    <span asp-validation-for="Input.Name" class="error"></span>
                </div>
                <div class="col-span-full">
                    <label asp-for="Input.Description" class="block text-sm font-medium leading-6 text-gray-900">
                        Description :
                        <textarea asp-for="Input.Description" placeholder="@Model.RealData.Description" cols="100" rows="10" class="block w-full rounded-md border-0 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-indigo-600 sm:text-sm sm:leading-6"></textarea>
                    </label>
                    <span asp-validation-for="Input.Description" class="error"></span>
                </div>
                <div class="col-span-full">
                    <label asp-for="Input.Publish" class="block text-sm font-medium leading-6 text-gray-900">
                        Publié :
                        <input type="checkbox" asp-for="Input.Publish" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"/>
                    </label>
                    <span asp-validation-for="Input.Publish" class="error"></span>
                </div>
            </form>
            <button type="submit" class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100">Modifier</button>
            <a class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100" asp-page="/Teacher/TeacherDashBoard">Retour</a>
        </div>
    </form>
    <form method="post" asp-page-handler="MoveExercise">
        <input type="hidden" asp-for="IdLesson"/>
        <div class="border-b border-gray-900/10 pb-12" style="margin:1.5rem">
            <h2 class="text-3xl font-semibold leading-7 text-gray-900">Leçon : @Model.RealData.Name</h2>
            <p class="mt-1 text-sm leading-6 text-gray-600">Vous pouvez modifier cette leçon pour vos étudiants.</p>
            
            <div class="col-span-full">
                <label for="exercise" class="block text-sm font-medium leading-6 text-gray-900">
                    Choisissez un exercice :
                    <select id="exercise" name="exercise" class="mt-2 rounded-md">
                        @foreach (var exercise in Model.ExercisesList)
                        {
                            <option value="@exercise.IdExercise">@exercise.Name</option>
                        }
                    </select>
                </label>
            </div>
            
            <div class="col-span-full flex items-center mt-4">
                <button type="submit" name="direction" value="up" class="rounded-full bg-gray-200 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-300">Up</button>
                <button type="submit" name="direction" value="down" class="ml-2 rounded-full bg-gray-200 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-300">Down</button>
            </div>
        </div>
    </form>
    
    
    @foreach (var exercise in Model.ExercisesList.OrderBy(e => e.Position)) {
        <partial name="Shared/_TeacherExercise" model="exercise"/>
    }
    </body>
</html>