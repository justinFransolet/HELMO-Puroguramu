@page "/exercise/suppressor/{idExercise:guid}"
@model Puroguramu.App.Pages.Teacher.ExerciseSuppressor

<!DOCTYPE html>

<html lang="fr">
<head>
    <title>@ViewData["Title"]</title>
    <meta charset="UTF-8">
    <link href="css/stylesheet.css" rel="stylesheet">
</head>
    <body class="container mx-auto mt-8">
        <form method="post">
            <input type="hidden" asp-for="IdExercise"/>
            <div class="border-b border-gray-900/10 pb-12" style="margin:1.5rem">
                <h2 class="text-3xl font-semibold leading-7 text-gray-900">Suppression de l'exercice : @Model.Name</h2>
                <p class="mt-1 text-sm leading-6 text-gray-600">Supprimer de l'exercice : attention cette action est définitive</p>
                <div class="mt-10 grid grid-cols-1 gap-x-6 gap-y-8 sm:grid-cols-6" style="margin-bottom: 1rem">
                    <div class="sm:col-span3">
                        <label asp-for="Confirm" class="block text-sm font-medium leading-6 text-gray-900">
                            Confirmation :
                            <input type="checkbox" asp-for="Confirm" class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"/>
                        </label>
                        <span asp-validation-for="Confirm" class="error"></span>
                    </div>
                </div>
                <button type="submit" class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100">Valider</button>
                <a class="relative z-10 rounded-full bg-gray-50 px-3 py-1.5 font-medium text-gray-600 hover:bg-gray-100" asp-page="/Teacher/TeacherDashBoard">Retour</a>
            </div>
        </form>
    </body>
</html>