@page
@using Microsoft.AspNetCore.Authorization
@model Puroguramu.App.Pages.DashBoard
@attribute [Authorize]

<!DOCTYPE html>

<html lang="fr">
    <head>
        <title>@ViewData["Title"]</title>
        <meta charset="UTF-8">
        <link href="css/stylesheet.css" rel="stylesheet">
    </head>
    <body>
        <div class="container mx-auto mt-8" style="margin-left: 2rem">
            <br/>
            <h1 class="text-3xl font-bold tracking-tight text-gray-900 sm:text-4xl">Dashboard</h1>
            <br/>
            @if (Model.LessonList.Count == 0)
            {
                <p>Aucune leçon trouvée</p>
            }
            @foreach (var item in Model.LessonList)
            {
                <partial name="Shared/_Lesson" model="item"/>
            }
        </div>
    </body>
</html>